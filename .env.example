NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WEBSOCKET_HOST=http://localhost:4000
NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_WEBSITE_URL=https://eventpass.whitewall.solutions
 
# Uploads are authorized by the backend. Do not expose AWS credentials in NEXT_PUBLIC_* variables.  
 
# Manual font-registry synchronization. Set a valid token locally before running npm run fonts:sync.
FONT_SYNC_URL=http://127.0.0.1:4000/api/global-config/fonts/sync
FONT_SYNC_TOKEN=
